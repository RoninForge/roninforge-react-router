# React Router 7 Route Modules

Every route file under `app/routes/` (and `app/root.tsx`) is a Route Module. v7 ships nine server-facing named exports, all typed via the per-route `Route` namespace generated by `react-router typegen`. The browser counterparts (`clientLoader`, `clientAction`, `HydrateFallback`) and middleware (`middleware`, `clientMiddleware`) are covered in `react-router-client-data.mdc`.

## Imports

```tsx
import type { Route } from "./+types/<route-file-base-name>";
import { data, Link, Form, Outlet, isRouteErrorResponse, useRouteError } from "react-router";
```

The `./+types/` path is virtual; typegen materializes it into `.react-router/types/`.

## Canonical full module

```tsx
// app/routes/products.$pid.tsx
import { data, Form, Link } from "react-router";
import type { Route } from "./+types/products.$pid";
import { z } from "zod";

export function meta({ data }: Route.MetaArgs) {
  return [{ title: data?.product.name ?? "Product" }];
}

export const links: Route.LinksFunction = () => [
  { rel: "preconnect", href: "https://cdn.example.com" },
];

export function headers(_args: Route.HeadersArgs) {
  return { "Cache-Control": "public, max-age=60" };
}

export const handle = { breadcrumb: "Product" };

export async function loader({ params }: Route.LoaderArgs) {
  const product = await getProduct(params.pid);
  if (!product) throw data({ message: "Not Found" }, { status: 404 });
  return { product };
}

const UpdateSchema = z.object({ name: z.string().min(1) });

export async function action({ request, params }: Route.ActionArgs) {
  const form = await request.formData();
  const parsed = UpdateSchema.safeParse(Object.fromEntries(form));
  if (!parsed.success) return data({ fieldErrors: parsed.error.flatten().fieldErrors }, { status: 400 });
  await updateProduct(params.pid, parsed.data);
  return { ok: true };
}

export function shouldRevalidate({ defaultShouldRevalidate, formAction }: Route.ShouldRevalidateFunctionArgs) {
  if (formAction === "/cart/add") return false;
  return defaultShouldRevalidate;
}

export default function Product({ loaderData, actionData }: Route.ComponentProps) {
  return (
    <article>
      <h1>{loaderData.product.name}</h1>
      <Form method="post">
        <input name="name" defaultValue={loaderData.product.name} />
        {actionData && "fieldErrors" in actionData && (
          <p role="alert">{actionData.fieldErrors.name?.[0]}</p>
        )}
        <button type="submit">Save</button>
      </Form>
      <Link to="/products" prefetch="intent">Back</Link>
    </article>
  );
}

export function ErrorBoundary({ error }: Route.ErrorBoundaryProps) {
  if (isRouteErrorResponse(error)) {
    return <div>{error.status} {error.statusText}: {error.data?.message}</div>;
  }
  return <div>Unexpected: {error instanceof Error ? error.message : "unknown"}</div>;
}
```

## Rules

- Use `Route.LoaderArgs`, `Route.ActionArgs`, `Route.MetaArgs`, `Route.HeadersArgs`, `Route.ComponentProps`, `Route.ErrorBoundaryProps`. Do not use `LoaderFunction`, `ActionFunction`, `LoaderFunctionArgs`, `MetaFunction`, `LinksFunction` (Data Mode types).
- Return plain values from loaders/actions. Use `data(value, init)` only when you need to set status or headers.
- Throw `data(payload, { status })` or `redirect(...)` rather than `new Error("...")`.
- Component receives `loaderData` and `actionData` as props; do not call `useLoaderData<typeof loader>()`.
- `ErrorBoundary` reads the error via `Route.ErrorBoundaryProps['error']` (or `useRouteError()`); branch on `isRouteErrorResponse(error)`.

## root.tsx Layout export

The root module must export `Layout` rendering `<Meta>`, `<Links>`, `<Scripts>`, `<ScrollRestoration>` from `react-router`. Without them the document never hydrates and scroll never restores.

```tsx
import { Links, Meta, Outlet, Scripts, ScrollRestoration, isRouteErrorResponse, useRouteError } from "react-router";

export function Layout({ children }: { children: React.ReactNode }) {
  return (
    <html lang="en">
      <head>
        <meta charSet="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <Meta />
        <Links />
      </head>
      <body>
        {children}
        <ScrollRestoration />
        <Scripts />
      </body>
    </html>
  );
}

export default function App() { return <Outlet />; }

export function ErrorBoundary() {
  const error = useRouteError();
  if (isRouteErrorResponse(error)) return <h1>{error.status}</h1>;
  return <h1>App crash</h1>;
}
```

